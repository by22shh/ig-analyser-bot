exports[`message snapshots > renders start payload 1`] = `
"👁 <b>SocialAnalyserBot</b> — разбор публичного Instagram-профиля.

🤝 Готовитесь к встрече, партнёрству или деловому контакту?
🕵️ Нужно аккуратно проверить публичный контекст профиля?
📣 Оцениваете автора, кандидата или личный бренд по открытым данным?

Пришлите @username или ссылку — соберу открытые данные и превращу их в понятный стратегический отчёт.

<b>Вы получите:</b>
• позиционирование и заметные сигналы профиля
• темы, визуальный стиль и повторяющиеся паттерны
• практические выводы для HR, блогинга или личной стратегии
• PDF/Markdown и чат по готовому отчёту

💎 Кредиты: <b>3</b>
🛒 Куплено: <b>3</b>
🧭 Режимы: <b>стандарт</b>
💳 Тарифы: стандарт 1
🌐 Язык отчёта: <b>ru</b>

Начните с кнопки «Анализ профиля»."
`;

