{
  "name": "ig-analyser-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "eval-analysis": "tsx scripts/eval-analysis-quality.ts",
    "audit-economics": "tsx scripts/audit-economics.ts",
    "audit-economics:defaults": "ECON_STANDARD_REPORT_COST_P75_RUB=55 ECON_PHOTO_SEARCH_COST_P75_RUB=20 ECON_CHAT_MESSAGE_COST_P75_RUB=2 ECON_APIFY_PROFILE_COST_RUB=12 ECON_FACECHECK_SEARCH_COST_RUB=15 ECON_SUPPORT_RESERVE_RUB=5 FACECHECK_MAX_COST_RUB=15 pnpm audit-economics",
    "ci": "pnpm prisma:generate && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test && pnpm audit-economics:defaults"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "grammy": "^1.32.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "playwright": "^1.49.1",
    "prisma": "^6.1.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
