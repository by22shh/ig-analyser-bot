# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_USE_LONG_POLLING=false
TELEGRAM_API_ROOT=https://api.telegram.org
CHANNEL_URL=https://t.me/homie_tech
SUPPORT_URL=https://t.me/homie_tech
TOS_URL=https://teletype.in/@homiebot/policy
PRIVACY_URL=https://telegram.org/privacy-tpa

# Database / queue
DATABASE_URL=postgresql://ig_analyser:ig_analyser@localhost:5432/ig_analyser_bot
DIRECT_URL=postgresql://ig_analyser:ig_analyser@localhost:5432/ig_analyser_bot
REDIS_URL=redis://localhost:6379/0

# External services
APIFY_TOKEN=
OPENROUTER_API_KEY=
FACECHECK_API_TOKEN=
FACECHECK_TESTING_MODE=false

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_TEST_MODE=true
# Empty value defaults to APP_BASE_URL + /payments/yookassa/return
YOOKASSA_RETURN_URL=
YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
YOOKASSA_CAPTURE=true
YOOKASSA_USE_RECEIPTS=true
YOOKASSA_DEFAULT_VAT_CODE=1
YOOKASSA_DEFAULT_TAX_SYSTEM_CODE=
YOOKASSA_PAYMENT_COMMISSION_RATE=0.028
YOOKASSA_RECEIPT_COMMISSION_RATE=0.010
YOOKASSA_COMMISSION_VAT_RATE=0.20

# Telegram Stars
TELEGRAM_STARS_TEST_MODE=true
TELEGRAM_STARS_DEFAULT_CURRENCY=XTR
TELEGRAM_STARS_REFUNDS_ENABLED=true

# Economics guardrails
ECON_USD_TO_RUB_BUFFER=90
ECON_PAYMENT_FEE_RESERVE=0.20
ECON_STARS_USD_PER_STAR_PAYOUT_FLOOR=0.01
ECON_STARS_PAYOUT_RESERVE=0.20
ECON_TARGET_REVENUE_MULTIPLE=3
ECON_COST_BASIS=p75
ECON_STANDARD_REPORT_COST_P75_RUB=
ECON_PHOTO_SEARCH_COST_P75_RUB=
ECON_CHAT_MESSAGE_COST_P75_RUB=
ECON_APIFY_PROFILE_COST_RUB=
ECON_FACECHECK_SEARCH_COST_RUB=
ECON_SUPPORT_RESERVE_RUB=

# Object storage for reports, temporary uploads, PDF artifacts
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Public-facing product name shown across all bot messages.
BRAND_NAME=SocialAnalyserBot
DEFAULT_LANGUAGE=ru
ADMIN_DEFAULT_CREDITS=100
# Free credits granted once to each new user (1 credit = one Standard report).
# Set to 0 to disable. Every granted report costs real provider money.
WELCOME_BONUS_CREDITS=1
REPORT_RETENTION_DAYS=30
PHOTO_UPLOAD_MAX_MB=10
ANALYSIS_POST_LIMIT=30
VISION_BATCH_SIZE=5
ANALYSIS_MAX_IMAGES_ANALYZED=30
ANALYSIS_MAX_IMAGE_DOWNLOAD_MB=8
LLM_STRUCTURED_OUTPUTS=true
LLM_FINAL_INPUT_TOKEN_BUDGET=
LLM_FINAL_OUTPUT_TOKEN_BUDGET=
LLM_REPAIR_OUTPUT_TOKEN_BUDGET=
LLM_VISION_OUTPUT_TOKEN_BUDGET=
LLM_CHAT_INPUT_TOKEN_BUDGET=
LLM_CHAT_OUTPUT_TOKEN_BUDGET=
FACECHECK_TIMEOUT_SECONDS=90
FACECHECK_MAX_COST_RUB=
PDF_RENDER_TIMEOUT_SECONDS=60
FEATURE_HR_MODE=false
FEATURE_INFLUENCER_MODE=true
FEATURE_OSINT_COMPLIANCE_MODE=false
FEATURE_PHOTO_SEARCH=false
FEATURE_TELEGRAM_STARS=true
FEATURE_YOOKASSA_PAYMENTS=true

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Models should be configurable and not hard-coded in business logic.
# Defaults are real, vision-capable OpenRouter slugs; override per cost/quality needs.
MODEL_VISION=google/gemini-2.5-flash
MODEL_REASONING=google/gemini-2.5-pro
MODEL_CHAT=google/gemini-2.5-flash
